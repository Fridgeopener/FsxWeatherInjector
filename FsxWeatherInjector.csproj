<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- FSX is 32-bit, its SimConnect client library is too -->
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FsxWeatherInjector</AssemblyName>
    <RootNamespace>FsxWeatherInjector</RootNamespace>
    <Version>0.5.0</Version>
    <AssemblyTitle>FSX Live Weather Injector</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <!-- Copy from: <FSX>\SDK\Core Utilities Kit\SimConnect SDK\lib\managed\ -->
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>lib\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- Icon also embedded so the window and tray can load the right size -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
